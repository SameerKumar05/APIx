# ==============================================================================
# APIx Environment Configuration Template
# SIH 2026 Problem Statement 26056: Real-time Airfare Price Index for India
# Copy this file to .env and replace with local / production values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Environment & Runtime
# ------------------------------------------------------------------------------
# Runtime environment: development | staging | production | testing
ENVIRONMENT=development

# Application host and port
API_HOST=0.0.0.0
API_PORT=8000

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Database & Persistence (PostgreSQL / TimescaleDB)
# ------------------------------------------------------------------------------
# Async database URL (for asyncpg / FastAPI backend)
DATABASE_URL=postgresql+asyncpg://apix_user:apix_password@localhost:5432/apix_db

# Synchronous database URL (for Alembic migrations)
DATABASE_URL_SYNC=postgresql://apix_user:apix_password@localhost:5432/apix_db

# ------------------------------------------------------------------------------
# Security, Ingestion Auth & CORS
# ------------------------------------------------------------------------------
# Secret key used for authenticating scraping and ingestion triggers / webhooks
INGESTION_SECRET_KEY=dev_ingestion_secret_key_change_in_production_32chars

# Application secret key for signing tokens / sessions
SECRET_KEY=dev_jwt_secret_key_change_in_production_minimum_32_bytes_long

# Allowed CORS origins (comma-separated URLs for frontend dashboards)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# External Airfare & Travel APIs
# ------------------------------------------------------------------------------
# Amadeus Flight Offers API Credentials (https://developers.amadeus.com)
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here
AMADEUS_ENV=test

# ------------------------------------------------------------------------------
# Ingestion & Scraping Parameters
# ------------------------------------------------------------------------------
# Run browser scrapers in headless mode (true / false)
SCRAPER_HEADLESS=true

# Scraping concurrency (number of parallel browser tabs/workers)
SCRAPER_CONCURRENCY=4

# Timeout per route scraping request in milliseconds
SCRAPER_TIMEOUT_MS=30000

# Rate limit delay between portal requests in seconds
SCRAPER_REQUEST_DELAY_SEC=2.5

# Booking horizons in days to collect (comma-separated: T+1, T+7, T+15, T+30)
BOOKING_WINDOWS=1,7,15,30

# ------------------------------------------------------------------------------
# Statistical & Index Engine Parameters
# ------------------------------------------------------------------------------
# Base period for price index (YYYY-MM)
INDEX_BASE_PERIOD=2026-01

# Base index value (standard baseline: 100.0)
INDEX_BASE_VALUE=100.0

# Path to DGCA passenger traffic weight data (CSV / JSON)
DGCA_TRAFFIC_DATA_PATH=data/dgca_passenger_traffic_weights.csv

# Default index formula: laspeyres | paasche | fisher | weighted_median
DEFAULT_INDEX_FORMULA=fisher

# Anomaly detection Z-score threshold (standard: 2.5 or 3.0)
ANOMALY_ZSCORE_THRESHOLD=2.5
