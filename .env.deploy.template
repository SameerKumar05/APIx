# ==============================================================================
# APIx GCE deploy env template — PLACEHOLDERS ONLY, never real secrets.
# Copy to /opt/apix/.env on the VM and fill each CHANGEME by running:
#   openssl rand -base64 32
# The VM .env must stay gitignored (mode 600) and must never be committed.
# ==============================================================================
POSTGRES_USER=CHANGEME_db_user
POSTGRES_PASSWORD=CHANGEME_generate_with_openssl_rand_base64_32
POSTGRES_DB=CHANGEME_db_name
SECRET_KEY=CHANGEME_generate_with_openssl_rand_base64_32
INGESTION_API_KEY=CHANGEME_generate_with_openssl_rand_base64_32
ENVIRONMENT=CHANGEME_production
# Must be a JSON ARRAY, not comma-separated - pydantic-settings parses this as JSON.
# A literal "*" is rejected at startup by config.py. Include the deployed frontend origin.
BACKEND_CORS_ORIGINS=["CHANGEME_https_frontend_origin"]
