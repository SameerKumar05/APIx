# ==============================================================================
# APIx GCE deploy env template — PLACEHOLDERS ONLY, never real secrets.
# Copy to /opt/apix/.env on the VM and fill each CHANGEME by running:
#   openssl rand -base64 32
# The VM .env must stay gitignored (mode 600) and must never be committed.
# ==============================================================================
POSTGRES_USER=CHANGEME_db_user
POSTGRES_PASSWORD=CHANGEME_generate_with_openssl_rand_base64_32
POSTGRES_DB=CHANGEME_db_name
# DATABASE_URL is deliberately ABSENT here: docker-compose.deploy.yml composes it
# (and DATABASE_URL_SYNC) from POSTGRES_USER/PASSWORD/DB above. Do NOT set it
# manually -- a hand-written value would silently disagree with the database the
# overlay actually starts.
SECRET_KEY=CHANGEME_generate_with_openssl_rand_base64_32
INGESTION_API_KEY=CHANGEME_generate_with_openssl_rand_base64_32
# Must not be `development` in production unless INGESTION_API_KEY is non-default:
# backend/app/core/config.py:65-81 refuses to boot otherwise.
ENVIRONMENT=CHANGEME_production
# Must be a JSON ARRAY, not comma-separated - pydantic-settings parses this as JSON.
# A literal "*" is rejected at startup by config.py. Must name the EXACT deployed
# frontend origin (scheme + host, no trailing slash) or every browser call fails
# preflight -- see deployment_run_2026-09-26.md section 6.
BACKEND_CORS_ORIGINS=["CHANGEME_https_frontend_origin"]
